{
  "name": "python-debug-plots",
  "displayName": "Python Debug Plots",
  "description": "Plot and inspect NumPy arrays, Pandas DataFrames and tensors live while debugging Python.",
  "version": "0.1.0",
  "publisher": "jlk-tools",
  "license": "MIT",
  "engines": {
    "vscode": "^1.89.0"
  },
  "categories": ["Debuggers", "Visualization", "Data Science"],
  "keywords": [
    "numpy",
    "pandas",
    "plot",
    "debug",
    "visualization",
    "debug visualizer",
    "dataframe",
    "tensor",
    "debugger",
    "data science"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/JanLucasK/Python-Debug-Visualizer.git"
  },
  "icon": "assets/icon.png",
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Evaluates expressions inside your debug session, which requires a trusted workspace."
    }
  },
  "main": "./dist/extension.js",
  "activationEvents": ["onDebug"],
  "contributes": {
    "commands": [
      {
        "command": "pythonDebugPlots.open",
        "title": "Open Plots",
        "category": "Python Debug Plots",
        "icon": "$(graph-line)"
      },
      {
        "command": "pythonDebugPlots.plotSelection",
        "title": "Plot Selection",
        "category": "Python Debug Plots"
      },
      {
        "command": "pythonDebugPlots.plotVariable",
        "title": "Plot",
        "category": "Python Debug Plots"
      },
      {
        "command": "pythonDebugPlots.refresh",
        "title": "Refresh",
        "category": "Python Debug Plots",
        "icon": "$(refresh)"
      }
    ],
    "keybindings": [
      {
        "command": "pythonDebugPlots.plotSelection",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "editorHasSelection && debugState == stopped"
      }
    ],
    "menus": {
      "debug/variables/context": [
        {
          "command": "pythonDebugPlots.plotVariable",
          "when": "debugType == debugpy || debugType == python",
          "group": "navigation@10"
        }
      ],
      "editor/context": [
        {
          "command": "pythonDebugPlots.plotSelection",
          "when": "editorHasSelection && debugState == stopped && editorLangId == python",
          "group": "debug@10"
        }
      ]
    },
    "configuration": {
      "title": "Python Debug Plots",
      "properties": {
        "pythonDebugPlots.maxPoints": {
          "type": "number",
          "default": 20000,
          "minimum": 100,
          "description": "Points transferred per series before downsampling. Statistics are always computed over the full value regardless of this setting."
        },
        "pythonDebugPlots.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Re-evaluate expressions each time the debugger stops."
        },
        "pythonDebugPlots.historyDepth": {
          "type": "number",
          "default": 20,
          "minimum": 0,
          "description": "Past captures kept per expression for the history scrubber. The current value is always shown regardless."
        }
      }
    }
  },
  "scripts": {
    "generate": "node scripts/pack-runtime.mjs",
    "build": "pnpm generate && node esbuild.mjs",
    "watch": "pnpm generate && node esbuild.mjs --watch",
    "typecheck": "pnpm generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "package": "pnpm -w run build && vsce package --no-dependencies"
  },
  "dependencies": {
    "@python-debug-visualizer/protocol": "workspace:*",
    "@python-debug-visualizer/webview": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/vscode": "^1.89.0",
    "@vscode/vsce": "^3.2.1",
    "ovsx": "^0.10.1",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
